{
  "name": "@hedgehood/maker",
  "version": "0.1.0",
  "description": "TypeScript SDK for market makers on the Hedgehood options RFQ gateway (testnet only; contracts not yet audited)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xHedgeHood/hedgehood-maker-sdk.git",
    "directory": "ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:live": "vitest run test/live.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "viem": "2.57.11",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "20.19.43",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
